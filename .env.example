# --- Pipeline Feature Flags ---
ENABLE_DATA_COLLECTION=true
ENABLE_OCR=false
ENABLE_AGENT=false

# --- Segmentor (Grounding DINO) ---
# false = run the HF model in-process on the GPU; true = call the hosted legacy API instead
USE_SEGMENTOR_API=false
# Full URL of the hosted POST endpoint, e.g. https://dino.example.com/api/v1/detect
SEGMENTOR_API_URL=
SEGMENTOR_API_TIMEOUT_S=180
GDINO_MODEL_ID=IDEA-Research/grounding-dino-tiny
# cuda | cpu
GDINO_DEVICE=cuda
# Long side the frame is downscaled to for inference (boxes are mapped back to full resolution)
GDINO_MAX_SIDE=1333
SEGMENT_PROMPT=barcode
GDINO_BOX_THRESHOLD=0.30
GDINO_TEXT_THRESHOLD=0.25
# Drop outer box if inner box overlap >= 0.80
CONTAINMENT_THRESHOLD=0.80
NMS_IOU_THRESHOLD=0.50
# 25% horizontal padding for quiet zones
SEGMENT_PAD_X=0.25
# 20% vertical padding
SEGMENT_PAD_Y=0.20
SEGMENT_MAX_COUNT=20
MIN_CROP_SIDE_PX=4
MAX_IMAGE_BYTES=31457280

# --- Parallel Code-Reader ---
SCANNER_THREADS=4

# --- Background Dataset Collector & Gemma Verifier ---
DATASET_DIR=./dataset
DATASET_QUEUE_MAXSIZE=32
DATASET_SHUTDOWN_TIMEOUT_S=20
DATASET_JPEG_QUALITY=95
# Save frames with zero detections as YOLO background samples
DATASET_SAVE_EMPTY=true
# Empty GEMMA_API_BASE_URL = store samples without Gemma verification
GEMMA_API_BASE_URL=http://host.docker.internal:8080/v1
GEMMA_API_KEY=sk-local-or-cloud-key
GEMMA_MODEL_NAME=gemma-3-27b-it
# multi_image | single_token_concurrent
GEMMA_BATCH_MODE=multi_image
GEMMA_MAX_BATCH_SIZE=8
GEMMA_TIMEOUT_S=10.0
GEMMA_MAX_CONCURRENCY=8
GEMMA_CROP_MAX_SIDE=896
# Some Gemma endpoints reject the "system" role; false puts the instruction in the user turn
GEMMA_USE_SYSTEM_ROLE=false
GEMMA_RETRIES=1
GEMMA_CIRCUIT_COOLDOWN_S=60

# --- OCR enrichment (requires the image built with UV_EXTRA_ARGS="--extra ocr") ---
# rapidocr | paddleocr
OCR_BACKEND=rapidocr

# --- VLM agent enrichment (empty = reuse the GEMMA_* values) ---
AGENT_API_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL_NAME=
AGENT_TIMEOUT_S=30
AGENT_MAX_CONCURRENCY=1

# --- FastAPI Server ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
